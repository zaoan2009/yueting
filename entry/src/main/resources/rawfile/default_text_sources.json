    "js": "function gwClean(s) {\n  var wide = String.fromCharCode(12288);\n  var nl = String.fromCharCode(10);\n  var t = String(s == null ? '' : s).replace(/<[^>]*>/g, ' ').split(wide).join(' ');\n  var parts = t.split(nl);\n  var out = [];\n  for (var i = 0; i < parts.length; i++) {\n    var line = parts[i].replace(/ +/g, ' ');\n    if (line) out.push(line);\n  }\n  return out.join(' ').trim();\n}\n\nfunction gwIndex() {\n  var hit = cache.get('gwBooks');\n  if (hit) {\n    try {\n      var old = JSON.parse(hit);\n      if (old && old.length >= 50) return old;\n    } catch (e) {}\n  }\n  var seen = {};\n  var out = [];\n  for (var p = 1; p <= 20; p++) {\n    var r = http.get('https://www.gushiwen.cn/guwen/Default.aspx?p=' + p, { timeout: 20000 });\n    if (!r.ok) {\n      log('书目第 ' + p + ' 页失败', r.status, r.error);\n      sleep(500);\n      continue;\n    }\n    var blocks = native.selAll('@css:.sonspic@html', r.body) || [];\n    for (var i = 0; i < blocks.length; i++) {\n      var b = blocks[i];\n      var href = native.sel('@css:p a[href^=\"/guwen/book_\"]@href', b) || '';\n      var name = gwClean(native.sel('@css:p a[href^=\"/guwen/book_\"]@text', b));\n      if (!href || !name) continue;\n      var url = href.indexOf('http') === 0 ? href : 'https://www.gushiwen.cn' + href;\n      if (seen[url]) continue;\n      seen[url] = 1;\n      var tags = native.selAll('@css:.book-tag span@text', b) || [];\n      var ps = native.selAll('@css:.cont p@text', b) || [];\n      out.push({\n        name: name,\n        author: gwClean(tags.length ? tags[0] : ''),\n        era: gwClean(tags.length > 1 ? tags[1] : ''),\n        kind: gwClean(tags.length > 2 ? tags[2] : ''),\n        intro: gwClean(ps.length ? ps[ps.length - 1] : '').substring(0, 200),\n        bookUrl: url\n      });\n    }\n    sleep(150);\n  }\n  if (out.length < 50) throw new Error('古籍书目只取到 ' + out.length + ' 本（站内约 200 本），多半是打太密被限流，过一两分钟再试');\n  cache.put('gwBooks', JSON.stringify(out), 86400);\n  log('已建古籍书目索引', out.length, '本');\n  return out;\n}\n\nfunction searchBooks(ctx) {\n  var key = gwClean(ctx.key);\n  if (!key) throw new Error('请输入书名、作者或类别，比如「红楼梦」「司马迁」「正史」');\n  var low = key.toLowerCase();\n  var hits = gwIndex().filter(function (b) {\n    return (b.name + ' ' + b.author + ' ' + b.era + ' ' + b.kind + ' ' + b.intro).toLowerCase().indexOf(low) >= 0;\n  });\n  if (!hits.length) throw new Error('书目里没有匹配「' + key + '」的古籍（站内共 200 本公版古籍，可试「论语」「史记」「菜根谭」，或到发现页按四库分类翻找）');\n  return hits;\n}\n\nfunction exploreBooks(ctx) {\n  var tag = gwClean(ctx.url);\n  var all = gwIndex();\n  if (!tag || tag.indexOf('全部') >= 0) return all;\n  var sep = tag.indexOf(':');\n  var dim = sep > 0 ? tag.substring(0, sep) : '类';\n  var val = sep > 0 ? tag.substring(sep + 1) : tag;\n  var stem = val.replace(/类$/, '');\n  var hits = all.filter(function (b) {\n    var field = dim === '部' ? b.kind : (dim === '朝' ? b.era : b.kind);\n    if (dim === '部') return field.indexOf(val) >= 0;\n    if (dim === '朝') return field === val;\n    return field.indexOf(val) >= 0 || (stem.length > 1 && field.indexOf(stem) >= 0);\n  });\n  if (!hits.length) throw new Error('分类「' + val + '」下暂时没有书目，换一个分类试试');\n  return hits;\n}",
