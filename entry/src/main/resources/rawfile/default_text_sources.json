      "text": "div.yd_text2@text",
      "replace": [
        {
          "pattern": "[  　]+"
        },
        {
          "pattern": "^ +",
          "flags": "gm"
        }
      ]
    },
    "detail": {
      "fields": {
        "name": "= htmlDecode(trim(default(sel('meta[property=\"og:novel:book_name\"]@content'), '')))",
        "author": "= htmlDecode(trim(default(sel('meta[property=\"og:novel:author\"]@content'), '')))",
        "intro": "= htmlDecode(trim(default(sel('meta[property=\"og:description\"]@content'), sel('meta[name=\"description\"]@content'))))",
        "kind": "= join(compact([htmlDecode(trim(default(sel('meta[property=\"og:novel:category\"]@content'), ''))), htmlDecode(trim(default(sel('meta[property=\"og:novel:status\"]@content'), '')))]), ' · ')",
        "lastChapter": "= htmlDecode(trim(default(sel('meta[property=\"og:novel:latest_chapter_name\"]@content'), '')))",
        "coverUrl": "= htmlDecode(trim(default(sel('meta[property=\"og:image\"]@content'), '')))",
        "tocUrl": "= baseUrl"
      }
    }
  },
