      }
    },
    "toc": {
      "fail": "= data ? (default(data.errors, '') != '' ? '七猫目录：' + str(default(data.errors.title, data.errors.details || '接口失败')) : (len(default(data.data.chapters, [])) > 0 ? '' : '七猫目录为空')) : '七猫目录返回了非 JSON 内容'",
      "list": "$.data.chapters[*]",
      "fields": {
        "title": "= trim(htmlDecode(default($.title, '第' + str(default($.index, '')) + '章')))",
        "url": "= qmChapterUrl(qmBookId(book.bookUrl), $.id)",
        "tag": "= str(default($.is_vip, '0')) == '1' ? 'APP/登录' : ''"
      }
    },
