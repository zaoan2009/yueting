      "text": ".article@text",
      "fail": "= len(trim(default(sel('.article@text'), ''))) > 0 ? '' : '这一章没有网页正文：连载 VIP/需登录章官网常不返回内容（目录会标 APP/登录），请换免费章或到七猫 App 阅读；不做付费绕过'",
      "replace": [
        {
          "pattern": "[\\u00a0\\u3000]+"
        },
        {
          "pattern": "^ +",
          "flags": "gm"
        }
      ]
