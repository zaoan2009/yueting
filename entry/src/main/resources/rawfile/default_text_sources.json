    "js": "function qmBookId(url) {\n  var m = String(url == null ? '' : url).match(/\\/shuku\\/(\\d+)/);\n  return m ? m[1] : '';\n}\nfunction qmChapterId(url) {\n  var m = String(url == null ? '' : url).match(/\\/shuku\\/\\d+-(\\d+)/);\n  return m ? m[1] : '';\n}\nfunction qmBookUrl(id) {\n  return 'https://www.qimao.com/shuku/' + String(id) + '/';\n}\nfunction qmChapterUrl(bookId, chapterId) {\n  return 'https://www.qimao.com/shuku/' + String(bookId) + '-' + String(chapterId) + '/';\n}\nfunction qmCover(u) {\n  var s = String(u == null ? '' : u).replace(/&amp;/g, '&').trim();\n  if (!s) return '';\n  if (s.indexOf('//') === 0) s = 'https:' + s;\n  return s;\n}\nfunction qmKind(a, b, status) {\n  var parts = [];\n  if (a) parts.push(String(a));\n  if (b && String(b) !== String(a)) parts.push(String(b));\n  if (status) parts.push(String(status));\n  return parts.join(' · ');\n}\n",
